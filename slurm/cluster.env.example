# slurm/cluster.env.example  --  TEMPLATE (this file IS committed; it has only placeholders).
#
# Copy it to slurm/cluster.env (which is gitignored and NEVER committed) and put your real,
# org-specific values there:
#
#     cp slurm/cluster.env.example slurm/cluster.env
#     $EDITOR slurm/cluster.env
#
# submit_nc_batch.sh and setup_env.sh source slurm/cluster.env automatically if it exists.
# The ':= ' syntax means "use this value unless it's already set in the environment", so:
#     explicit command-line env  >  slurm/cluster.env  >  the built-in script defaults.
#
# ⚠️  Never `git add slurm/cluster.env`. It is intentionally untracked so your cluster settings
#     stay out of the public repo.

# --- SLURM placement (institution-specific) -------------------------------------------------
: "${PARTITIONS:=gpu}"                 # comma-separated GPU partition(s) SLURM may pick from
: "${GRES:=gpu:1}"                     # any single GPU; pin a type only if required, e.g. gpu:a100:1
# : "${SBATCH_ACCOUNT:=}"              # if your cluster needs --account, set it here and add the #SBATCH line

# --- environment activation (how a job gets conda + the env) --------------------------------
: "${CONDA_ENV:=ncgenjax}"             # the cluster-side conda/mamba env from setup_env.sh
: "${CONDA_BASE:=}"                    # e.g. $HOME/miniforge3 ; empty -> discovered via `conda info --base`
: "${MODULE_LOADS:=}"                  # e.g. 'module load miniforge' ; ';'-separate multiple module loads

# --- resource sizing (tune to your own seff measurements / quotas) --------------------------
: "${MEM:=12G}"
: "${MAX_PARALLEL:=20}"
: "${MAX_TIME:=3:59:00}"
: "${SENTENCES_PER_SHARD:=8}"

# --- env setup (setup_env.sh) ---------------------------------------------------------------
: "${GENJAX_SRC:=$HOME/genjax}"        # where the genjax checkout lives / will be cloned
