# Shared base for the two main experiment arms (harness plan §5). NOT submittable on its own --
# it deliberately sets no REJUV (the arms differ in REJUV and NOTHING else, a user decision;
# run.sh refuses a pair of configs that differ in anything but REJUV).
# The operating point is the stability benchmark's general-purpose one: P=64, lookback 6,
# >=4 seeds evidence-merged (planning/BENCHMARK_STABILITY_REPORT.md).
CHANNEL=align
PARTICLES=64
N_SEEDS=4
REJUV_LOOKBACK=6
BAND=2
MAX_DIST=2
SEED=0
WRITE_VIZ=0
SORT_BY_LENGTH=1
TOP=20
# Lookahead charge at resampling (planning/LOOKAHEAD_CHARGE_PLAN.md), user decision 2026-08-31
# after the gate results + battery A/B (artifact on 46/87 battery items -> 7; logZ mean +4.05;
# matches-expected +2). Both arms inherit it, so the off-vs-rejuv contrast stays single-variable.
LOOKAHEAD=1
# Lookahead charge folded into the candidate PROPOSAL too (planning/OFF_ARM_INFERENCE_FIX.md sec 5),
# user decision 2026-09-01 after the battery A/B passed all four pre-committed criteria (artifact items
# 4 -> 0, repairs retained 14/43, edited 28 -> 26, logZ +1.04, 4-seed logZ spread 6.70 -> 1.34).
# Both arms inherit it, so the off-vs-rejuv contrast stays single-variable.
LA_PROPOSAL=1
