# Shared base for the two main experiment arms (harness plan §5). NOT submittable on its own --
# it deliberately sets no REJUV (the arms differ in REJUV and NOTHING else, a user decision;
# run.sh refuses a pair of configs that differ in anything but REJUV).
# The operating point is the stability benchmark's general-purpose one: P=64, lookback 6,
# >=4 seeds evidence-merged (planning/BENCHMARK_STABILITY_REPORT.md).
CHANNEL=align
PARTICLES=64
N_SEEDS=4
REJUV_LOOKBACK=6
BAND=2
MAX_DIST=2
SEED=0
WRITE_VIZ=0
SORT_BY_LENGTH=1
TOP=20
