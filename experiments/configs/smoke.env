# Pipeline smoke config (harness plan §5): cheap enough for a laptop or a single cluster task.
# Used by `run.sh smoke-local` on stimuli/smoke.input.jsonl -- build -> run -> words block ->
# tidy outputs, end to end.
CHANNEL=align
REJUV=off
PARTICLES=16
N_SEEDS=1
WRITE_VIZ=0
SORT_BY_LENGTH=1
TOP=10
